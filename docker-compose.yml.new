# =============================================================================
# HT Base - Microservices Docker Compose (VPS Deployment)
# =============================================================================
# Usage:
#   docker compose -f docker-compose.microservices.yml up -d
#   docker compose -f docker-compose.microservices.yml up -d --scale archive-worker-singlefile=3
#
# Prerequisites:
#   - Copy .env.microservices.example to .env.microservices
#   - Set up GCS credentials (or use STORAGE_PROVIDER=local)
#   - Create artifacts directory: mkdir -p ./data/artifacts
#   - Ensure archivebox_default network exists: docker network create archivebox_default
# =============================================================================

x-common-env: &common-env
  REDIS_URL: redis://redis:6379/0
  CELERY_BROKER_URL: redis://redis:6379/0
  CELERY_RESULT_BACKEND: redis://redis:6379/1

  # ===========================================================================
  # API Gateway
  # ===========================================================================

  api-gateway:
    image: ${REGISTRY:-}htbase/api-gateway:${VERSION:-latest}
    build:
      context: .
      dockerfile: services/api-gateway/Dockerfile
    # OtterStack: container names auto-generated
    restart: unless-stopped
    ports:
      - "${API_PORT:-8080}:8080"
    environment:
      <<: *common-env
      PORT: 8080
      WORKERS: ${API_WORKERS:-4}
      CORS_ORIGINS: ${CORS_ORIGINS:-*}
      API_RATE_LIMIT: ${API_RATE_LIMIT:-100/minute}
      # Task configuration
      DEFAULT_ARCHIVERS: ${DEFAULT_ARCHIVERS:-singlefile,monolith,readability,pdf,screenshot}
      ENABLE_SUMMARIZATION: ${ENABLE_SUMMARIZATION:-true}
    depends_on:
      redis:
        condition: service_healthy

  archive-worker-screenshot:
    <<: *archive-worker
    # OtterStack: container names auto-generated
    environment:
      <<: *common-env
      WORKER_QUEUES: archive.screenshot
      WORKER_CONCURRENCY: ${SCREENSHOT_CONCURRENCY:-3}
      ARCHIVER_TYPE: screenshot
      ARCHIVER_TIMEOUT: 60
    shm_size: 1gb
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 2G
        reservations:
          cpus: "0.5"
          memory: 1G

  # ===========================================================================
  # Summarization Worker
  # ===========================================================================

  summarization-worker:
    <<: *worker-base
    image: ${REGISTRY:-}htbase/summarization-worker:${VERSION:-latest}
    build:
      context: .
      dockerfile: services/summarization-worker/Dockerfile
    # OtterStack: container names auto-generated
    environment:
      <<: *common-env
      WORKER_QUEUES: summarization
      WORKER_CONCURRENCY: ${SUMMARIZATION_CONCURRENCY:-5}
      # LLM Provider Configuration
      LLM_PROVIDER: ${LLM_PROVIDER:-huggingface}
      HUGGINGFACE_API_URL: ${HUGGINGFACE_API_URL:-}
      HUGGINGFACE_API_KEY: ${HUGGINGFACE_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      OPENAI_MODEL: ${OPENAI_MODEL:-gpt-4o-mini}
      # Chunking configuration
      CHUNK_SIZE: ${CHUNK_SIZE:-4000}
      CHUNK_OVERLAP: ${CHUNK_OVERLAP:-200}
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 1G
        reservations:
          cpus: "0.5"
          memory: 512M

  # ===========================================================================
  # Storage Worker
  # ===========================================================================

  storage-worker:
    <<: *worker-base
    image: ${REGISTRY:-}htbase/storage-worker:${VERSION:-latest}
    build:
      context: .
      dockerfile: services/storage-worker/Dockerfile
    # OtterStack: container names auto-generated
    environment:
      <<: *common-env
      WORKER_QUEUES: storage
      WORKER_CONCURRENCY: ${STORAGE_CONCURRENCY:-10}
      STORAGE_PROVIDER: ${STORAGE_PROVIDER:-gcs}
      LOCAL_STORAGE_PATH: /app/artifacts
      COMPRESSION_ENABLED: ${COMPRESSION_ENABLED:-true}
      CLEANUP_AFTER_UPLOAD: ${CLEANUP_AFTER_UPLOAD:-true}
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 1G
        reservations:
          cpus: "0.5"
          memory: 256M

  # ===========================================================================
  # Sync Worker (For PostgreSQL to Firestore data sync for dual persistence)
  # ===========================================================================

  sync-worker:
    <<: *worker-base
    image: ${REGISTRY:-}htbase/sync-worker:${VERSION:-latest}
    build:
      context: .
      dockerfile: services/sync-worker/Dockerfile
    # OtterStack: container names auto-generated
    environment:
      <<: *common-env
      WORKER_QUEUES: sync
      WORKER_CONCURRENCY: ${SYNC_CONCURRENCY:-1}
      FIRESTORE_PROJECT_ID: ${GCS_PROJECT_ID:-}
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 2G
        reservations:
          cpus: "0.5"
          memory: 512M
    profiles:
      - sync

  # ===========================================================================
  # Monitoring Services
  # ===========================================================================

  flower:
    image: mher/flower:2.0
    # OtterStack: container names auto-generated
    restart: unless-stopped
    command: >
      celery
      --broker=redis://redis:6379/0
      flower
      --port=5555
      --basic_auth=${FLOWER_USER:-admin}:${FLOWER_PASSWORD:-admin}
      --persistent=true
      --db=/data/flower.db
      --url_prefix=/flower
    ports:
      - "${FLOWER_PORT:-5555}:5555"
    volumes:
      - flower-data:/data
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - archivebox_default
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.htbase-flower.rule=Host(`${DOMAIN:-localhost}`) && PathPrefix(`/flower`)"
      - "traefik.http.routers.htbase-flower.entrypoints=websecure"
      - "traefik.http.routers.htbase-flower.tls.certresolver=letsencrypt"
      - "traefik.http.routers.htbase-flower.middlewares=monitoring-auth@file"
      - "traefik.http.services.htbase-flower.loadbalancer.server.port=5555"

  redis-commander:
    image: rediscommander/redis-commander:latest
    # OtterStack: container names auto-generated
    restart: unless-stopped
    environment:
      REDIS_HOSTS: local:redis:6379
      HTTP_USER: ${REDIS_COMMANDER_USER:-admin}
      HTTP_PASSWORD: ${REDIS_COMMANDER_PASSWORD:-admin}
    ports:
      - "${REDIS_COMMANDER_PORT:-8081}:8081"
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - archivebox_default
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.htbase-redis.rule=Host(`${DOMAIN:-localhost}`) && PathPrefix(`/redis`)"
      - "traefik.http.routers.htbase-redis.entrypoints=websecure"
      - "traefik.http.routers.htbase-redis.tls.certresolver=letsencrypt"
      - "traefik.http.routers.htbase-redis.middlewares=monitoring-auth@file,strip-redis@file"
      - "traefik.http.services.htbase-redis.loadbalancer.server.port=8081"

  # ===========================================================================
  # Reverse Proxy - Traefik (Optional - use --profile proxy)
  # ===========================================================================
  # If you already have Traefik running, skip this and add the labels to your
  # existing Traefik configuration. See infrastructure/traefik/ for examples.
  # ===========================================================================

# =============================================================================
# Networks
# =============================================================================

networks:
  archivebox_default:
    external: true

# =============================================================================
# Volumes
# =============================================================================

volumes:
  redis-data:
    driver: local
  postgres-data:
    driver: local
  artifacts:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ${ARTIFACTS_PATH:-./data/artifacts}
  flower-data:
    driver: local
